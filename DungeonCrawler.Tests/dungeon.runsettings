<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <TestRunParameters>
    <!--
      Where your tests send the browser. This points at the live dungeon. If
      you run a copy of the dungeon on your own machine, change this one line
      to http://localhost:5299.
    -->
    <Parameter name="DungeonUrl" value="https://playwright-dungeon-crawl.onrender.com" />
    <!--
      Victory pause: after TakeTreasureAsync finds the treasure, the browser
      stays open this many seconds so you can see the room give it up.
      0 turns it off.
    -->
    <Parameter name="VictoryPauseSeconds" value="3" />
  </TestRunParameters>

  <Playwright>
    <BrowserName>chromium</BrowserName>
    <LaunchOptions>
      <!-- false = you can watch the browser while your test runs. -->
      <Headless>false</Headless>
      <!--
        Slow motion: waits this many milliseconds after every action, so you
        can follow along. Remove the comment markers around the next line to
        turn it on. Turn it off again for timed trap rooms, or you'll run out
        of time.
      -->
      <!-- <SlowMo>1000</SlowMo> -->
    </LaunchOptions>
  </Playwright>
</RunSettings>
