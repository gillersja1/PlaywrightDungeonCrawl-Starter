<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <TestRunParameters>
    <!--
      Where your tests send the browser. This points at a copy of the dungeon
      running on your own machine. If the dungeon lives somewhere else, change
      this one line.
    -->
    <Parameter name="DungeonUrl" value="http://localhost:5299" />
  </TestRunParameters>

  <Playwright>
    <BrowserName>chromium</BrowserName>
    <LaunchOptions>
      <!-- false = you can watch the browser while your test runs. -->
      <Headless>false</Headless>
      <!--
        Slow motion: waits this many milliseconds after every action, so you
        can follow along. Remove the comment markers around the next line to
        turn it on. Turn it off again for timed trap rooms, or you'll run out
        of time.
      -->
      <!-- <SlowMo>1000</SlowMo> -->
    </LaunchOptions>
  </Playwright>
</RunSettings>
